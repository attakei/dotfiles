# ----
# Build and persist aqua environment variables (AQUA_GLOBAL_CONFIG / AQUA_POLICY_CONFIG).
#
# Sources:
# - Base: app/aqua/ of this repository
# - Extends: extends/*/app/aqua/ (git-ignored, usually symlinks to other repositories)
#
# Values are persisted to OS-level storage so that applications launching shells directly
# (e.g. Windows terminal emulators starting nu) can see them.
# - Windows: User environment variables
# - Others: ~/.config/aqua-env.sh (sourced by ~/.profile, ~/.bashrc and ~/.zshenv)
# ----
use std/log

const DOTFILES_ROOT = path self | path dirname | path dirname

let IS_WINDOWS = uname | get kernel-name | str contains 'Windows_NT'

# Collect directories that may have aqua configuration.
let extends_dir = $DOTFILES_ROOT | path join 'extends'

let extends = if ($extends_dir | path exists) {
    ls $extends_dir | get name | sort | each {|it| $it | path join 'app' 'aqua' }
} else { [] }

let aqua_dirs = [
    ($DOTFILES_ROOT | path join 'app' 'aqua')
] | append $extends

# AQUA_POLICY_CONFIG fails entirely when it has a missing path, so pick only existing files.
def collect [dirs: list<string>, filename: string] {
    $dirs | each {|d| $d | path join $filename } | where {|p| $p | path exists }
}

let global_configs = collect $aqua_dirs 'aqua.yaml'
let policy_configs = collect $aqua_dirs 'aqua-policy.yaml'
let global_value = $global_configs | str join (char esep)
let policy_value = $policy_configs | str join (char esep)

if $IS_WINDOWS {
    for $item in [
        [name, value];
        ['AQUA_GLOBAL_CONFIG', $global_value]
        ['AQUA_POLICY_CONFIG', $policy_value]
    ] {
        let cmd = $"[Environment]::SetEnvironmentVariable\('($item.name)', '($item.value)', 'User'\)"
        ^powershell -NoProfile -Command $cmd
    }
    log info 'Updated User environment variables.'
} else {
    let env_file = $env.HOME | path join '.config' 'aqua-env.sh'
    let aqua_bin = (
        $env.AQUA_ROOT_DIR?
        | default ($env.XDG_DATA_HOME? | default ($env.HOME | path join '.local' 'share') | path join 'aquaproj-aqua')
        | path join 'bin'
    )
    mkdir ($env_file | path dirname)
    [
        '# Generated by dotfiles/scripts/aqua-env.nu. Do not edit manually.'
        $'export AQUA_GLOBAL_CONFIG="($global_value)"'
        $'export AQUA_POLICY_CONFIG="($policy_value)"'
        $'export PATH="($aqua_bin):$PATH"'
        ''
    ] | str join "\n" | save -f $env_file
    log info $'Updated ($env_file).'
}

print $'AQUA_GLOBAL_CONFIG:'
$global_configs | each {|p| print $'  - ($p)' } | ignore
print $'AQUA_POLICY_CONFIG:'
$policy_configs | each {|p| print $'  - ($p)' } | ignore
